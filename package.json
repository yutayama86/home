{
  "name": "shikumi-base",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "シクミベース - 中小企業・地域企業のWeb・集客・業務を仕組み化する事業ブランド",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "og": "bash tools/build-og.sh",
    "quality": "node scripts/quality-check.mjs",
    "growth": "node scripts/daily-growth.mjs",
    "topic": "node scripts/select-daily-topic.mjs",
    "verify": "npm run check && npm run build && npm run quality",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=shikumi-base --branch=main",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
