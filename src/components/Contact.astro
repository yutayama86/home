---
import { ctaHref } from '../site.config';
import { services } from '../data/taxonomy';

/** トップページ下部のCTA帯。相談内容ごとに入口を分けて、心理的な負担を下げる。 */
const entries = [
  ...services.map((s) => ({ topic: s.id, label: s.ctaLabel })),
  { topic: 'organize', label: '自社の課題を整理したい' },
];
---

<section class="contact section on-dark" id="contact">
  <div class="wrap contact__inner">
    <div class="contact__body reveal">
      <p class="kicker">ご相談について<span class="kicker__en">CONTACT</span></p>
      <h2 class="contact__title">
        <span class="phrase">何から始めるか、</span><span class="phrase">一緒に整理します。</span>
      </h2>
      <p class="contact__lead measure">
        依頼内容が固まっていなくても大丈夫です。いまの状況を伺ったうえで、
        Web・集客・業務改善のどこから手を付けるとよいかを一緒に整理するところから始めます。
      </p>

      <div class="contact__actions">
        <a class="btn btn--on-dark" href={ctaHref()} data-cta="home-contact">
          相談する<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="contact__topics reveal" data-delay="1">
      <h3 class="contact__topics-title">相談内容から選ぶ</h3>
      <ul class="topics">
        {entries.map((entry) => (
          <li>
            <a
              class="topic"
              href={ctaHref(entry.topic)}
              data-cta="home-contact-topic"
              data-cta-topic={entry.topic}
            >
              {entry.label}
              <span class="topic__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--navy);
    color: var(--text-on-dark);
  }

  .kicker__en {
    margin-left: 8px;
    opacity: 0.7;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(36px, 5vw, 80px);
    align-items: start;
  }

  .contact__title {
    font-size: var(--fs-h2);
  }

  .contact__lead {
    margin-top: clamp(18px, 2.2vw, 26px);
    color: var(--text-on-dark-mute);
  }

  .contact__actions {
    margin-top: clamp(26px, 3vw, 36px);
  }

  .contact__topics-title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-on-dark-mute);
  }

  .topics {
    margin-top: 16px;
    border-top: 1px solid var(--line-on-dark);
  }

  .topic {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line-on-dark);
    font-size: var(--fs-body-sm);
    font-weight: 700;
    color: #fff;
    transition: padding-left 0.25s var(--ease), color 0.2s var(--ease);
  }

  .topic:hover {
    padding-left: 12px;
    color: var(--sky);
  }

  .topic__arrow {
    color: var(--gold);
    transition: transform 0.25s var(--ease);
  }

  .topic:hover .topic__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }

    .contact__actions .btn {
      width: 100%;
    }
  }
</style>
