---
const systems = [
  {
    no: '01',
    title: '集客の仕組み',
    lead: '発信や広告を、単発で終わらせない。',
    body: 'Web、SEO、SNS、コンテンツ、導線を整理し、見込み客との接点が継続的に積み上がる状態をつくります。',
  },
  {
    no: '02',
    title: '営業の仕組み',
    lead: '営業し続けなくても、判断材料が届く状態へ。',
    body: '問い合わせ前後の情報設計、事例、比較材料、フォローを整え、反響から商談までを再現できる流れにします。',
  },
  {
    no: '03',
    title: '業務の仕組み',
    lead: '社長や特定担当者しかできない仕事を減らす。',
    body: '業務フロー、役割、手順、データ、AI活用を整理し、引き継げる・改善できる運用に変えます。',
  },
  {
    no: '04',
    title: '改善の仕組み',
    lead: '感覚ではなく、数字と記録で次を決める。',
    body: '重要指標と変更履歴をつなぎ、何を続け、何をやめ、どこを改善するかを判断できる状態をつくります。',
  },
];

const fit = [
  '社長や一部の担当者に仕事が集中している',
  '集客や営業が紹介・人脈・個人の頑張りに依存している',
  'WebやSNSをやっているが事業成果につながっているか分からない',
  'AIやツールを導入したが業務フローに定着していない',
  '成果が出た方法を他の人でも再現できる形にしたい',
  '人数を増やす前に、今の業務を整理したい',
];
---

<section class="services section" id="service">
  <div class="wrap">
    <div class="services__head reveal">
      <p class="kicker">仕組みに変える領域<span class="kicker__en">SYSTEM</span></p>
      <h2 class="section-title">
        <span class="phrase">人の頑張りを、</span><span class="phrase">事業の仕組みへ。</span>
      </h2>
      <p class="section-lead measure">
        シクミベースが提供するのは、Web制作やAI導入そのものではありません。
        課題を整理し、必要な手段を組み合わせ、成果が継続的に積み上がる運用へ落とし込みます。
      </p>
    </div>

    <ol class="system-grid">
      {systems.map((item, index) => (
        <li class="system reveal" data-delay={String(index)}>
          <span class="system__no">{item.no}</span>
          <h3 class="system__title">{item.title}</h3>
          <p class="system__lead">{item.lead}</p>
          <p class="system__body">{item.body}</p>
        </li>
      ))}
    </ol>

    <div class="fit reveal">
      <div class="fit__head">
        <p class="fit__label">こんな状態から始めます</p>
        <h3>仕組み化が効きやすい会社</h3>
        <p>
          すべてを自動化することが目的ではありません。人が判断すべき仕事と、仕組みに任せる仕事を分けて設計します。
        </p>
      </div>

      <ul class="fit__list">
        {fit.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="services__actions reveal">
      <a class="btn btn--primary" href="/contact/?topic=system" data-cta="home-system-consult">
        自社の課題を相談する<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <p>
        最初から大規模なシステム導入を前提にせず、課題整理と小さな検証から始めます。
      </p>
    </div>
  </div>
</section>

<style>
  .services { background: var(--sky-soft); }
  .kicker__en { margin-left: 8px; color: var(--text-mute); font-weight: 700; opacity: 0.85; }
  .services__head { max-width: 50em; }
  .system-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: clamp(40px, 5vw, 64px); background: var(--line-strong); border: 1px solid var(--line-strong); }
  .system { padding: clamp(26px, 3vw, 40px); background: var(--paper); }
  .system__no { display: block; font-size: 0.6875rem; font-weight: 700; letter-spacing: var(--ls-label); color: var(--blue); }
  .system__title { margin-top: 10px; font-size: var(--fs-h3); color: var(--navy); }
  .system__lead { margin-top: 12px; font-weight: 700; color: var(--blue-ink); }
  .system__body { margin-top: 8px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .fit { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(30px, 4vw, 64px); margin-top: clamp(44px, 5vw, 72px); padding: clamp(28px, 4vw, 48px); background: var(--navy); color: var(--text-on-dark); }
  .fit__label { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; color: var(--text-on-dark-mute); }
  .fit__head h3 { margin-top: 10px; font-size: clamp(1.4rem, 1.15rem + 1vw, 2rem); }
  .fit__head p:last-child { margin-top: 16px; font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .fit__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 20px; }
  .fit__list li { position: relative; padding-left: 24px; font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .fit__list li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
  .services__actions { display: flex; align-items: center; gap: 24px; margin-top: 28px; }
  .services__actions p { max-width: 50em; font-size: 0.75rem; color: var(--text-mute); }
  @media (max-width: 860px) { .fit { grid-template-columns: 1fr; } }
  @media (max-width: 680px) { .system-grid, .fit__list { grid-template-columns: 1fr; } .services__actions { align-items: stretch; flex-direction: column; } }
</style>
