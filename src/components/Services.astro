---
const systems = [
  {
    no: '01',
    title: '初動を止めない',
    lead: '問い合わせを受けた事実を、すぐに返す。',
    body: '5分以内を目標に受信確認を送り、未対応や期限超過を担当者へ通知します。',
  },
  {
    no: '02',
    title: '現調前に揃える',
    lead: '聞き直しを減らし、訪問準備を早くする。',
    body: '写真、施工場所、希望時期など、現地調査前に必要な情報を回収します。',
  },
  {
    no: '03',
    title: '見積後を放置しない',
    lead: '次回行動日と3回のフォローを標準にする。',
    body: '案件段階を台帳で管理し、合意した見積フォローが予定どおり動く形にします。',
  },
  {
    no: '04',
    title: '数字で改善する',
    lead: 'PVの先にある営業段階まで確認する。',
    body: 'GA4・Search Console・営業段階をつなぎ、反響、現調、見積、受注を同じ画面で追います。',
  },
];

const fit = [
  '一般のお客様から直接受注している',
  'Web・LINE等から月10件以上の反響がある',
  '平均工事単価が80万円以上',
  '問い合わせ管理が紙・Excel・担当者に分散している',
  '過去90日の反響・現調・見積・受注数を確認できる',
  '社長または担当責任者が設計と検収に参加できる',
];
---

<section class="services section" id="service">
  <div class="wrap">
    <div class="services__head reveal">
      <p class="kicker">30日で整えること<span class="kicker__en">SYSTEM</span></p>
      <h2 class="section-title">
        <span class="phrase">反響対応を支える、</span><span class="phrase">4つの仕組み。</span>
      </h2>
      <p class="section-lead measure">
        AIやツールの導入を目的にしません。いま使っているサイト、メール、LINE、Google環境を確認し、
        必要な部分だけをつないで運用できる状態にします。
      </p>
    </div>

    <ol class="system-grid">
      {systems.map((item, index) => (
        <li class="system reveal" data-delay={String(index)}>
          <span class="system__no">{item.no}</span>
          <h3 class="system__title">{item.title}</h3>
          <p class="system__lead">{item.lead}</p>
          <p class="system__body">{item.body}</p>
        </li>
      ))}
    </ol>

    <div class="fit reveal">
      <div class="fit__head">
        <p class="fit__label">導入前に確認します</p>
        <h3>この仕組みが向いている会社</h3>
        <p>
          条件が合わない場合は、無理に実装をおすすめしません。先に集客や別の課題へ着手したほうがよいケースもあります。
        </p>
      </div>

      <ul class="fit__list">
        {fit.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="services__actions reveal">
      <a class="btn btn--primary" href="/service/reform-lead-os/" data-cta="home-product-detail">
        対象範囲と価格を見る<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <p>
        反響自体がほぼない会社、基幹システムの全面刷新、成果報酬・売上保証・無制限修正には適していません。
      </p>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--sky-soft);
  }

  .kicker__en {
    margin-left: 8px;
    color: var(--text-mute);
    font-weight: 700;
    opacity: 0.85;
  }

  .services__head {
    max-width: 50em;
  }

  .system-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(40px, 5vw, 64px);
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
  }

  .system {
    padding: clamp(26px, 3vw, 40px);
    background: var(--paper);
  }

  .system__no {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: var(--ls-label);
    color: var(--blue);
  }

  .system__title {
    margin-top: 10px;
    font-size: var(--fs-h3);
    color: var(--navy);
  }

  .system__lead {
    margin-top: 12px;
    font-weight: 700;
    color: var(--blue-ink);
  }

  .system__body {
    margin-top: 8px;
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .fit {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(30px, 4vw, 64px);
    margin-top: clamp(44px, 5vw, 72px);
    padding: clamp(28px, 4vw, 48px);
    background: var(--navy);
    color: var(--text-on-dark);
  }

  .fit__label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-on-dark-mute);
  }

  .fit__head h3 {
    margin-top: 10px;
    font-size: clamp(1.4rem, 1.15rem + 1vw, 2rem);
  }

  .fit__head p:last-child {
    margin-top: 16px;
    font-size: var(--fs-body-sm);
    color: var(--text-on-dark-mute);
  }

  .fit__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 20px;
  }

  .fit__list li {
    position: relative;
    padding-left: 24px;
    font-size: var(--fs-body-sm);
    color: var(--text-on-dark-mute);
  }

  .fit__list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-weight: 700;
  }

  .services__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
  }

  .services__actions p {
    max-width: 50em;
    font-size: 0.75rem;
    color: var(--text-mute);
  }

  @media (max-width: 860px) {
    .fit {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .system-grid,
    .fit__list {
      grid-template-columns: 1fr;
    }

    .services__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
