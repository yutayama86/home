---
import '../styles/global.css';
import { site, analytics } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  /** 記事ページの公開・更新日時（og:article 用）。 */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 記事ごとに固有のOGP画像がある場合のパス。 */
  image?: string;
  /** 検索結果から除外したいページ（サンクスページなど）。 */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonical = new URL(Astro.url.pathname, site.url).href,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  image,
  noindex = false,
} = Astro.props;

/* OGP画像は絶対URLで指定する必要がある。
   版下は tools/og-image.html、再生成は `npm run og`。 */
const ogImage = new URL(image ?? '/og.png', site.url).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f9fc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="シクミベース｜住宅リフォーム会社の反響・見積フォローを仕組み化" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* JSが有効なときだけスクロール表示の初期状態を適用する（JS無効でも本文が読める） */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot />

    <script is:inline>
      (() => {
        const targets = document.querySelectorAll('.reveal');
        if (!targets.length) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );

        targets.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      /* CTAのクリックを計測する。data-cta の値で設置場所を区別し、
         どの導線が問い合わせにつながったかを追えるようにする。 */
      (() => {
        document.addEventListener('click', (event) => {
          const target = event.target.closest('[data-cta]');
          if (!target || typeof window.gtag !== 'function') return;

          window.gtag('event', 'cta_click', {
            cta_location: target.dataset.cta,
            cta_topic: target.dataset.ctaTopic || '',
            page_path: location.pathname,
            transport_type: 'beacon',
          });
        });
      })();
    </script>

    {/*
      Cloudflare Web Analytics。トークン未設定のときは何も出力しない。
      Cookieを使わないため同意バナーは不要。defer で描画を妨げない。
    */}
    {analytics.cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
      />
    )}

    {/*
      Google Analytics 4。測定ID未設定のときは何も出力しない。
      body末尾に async で置き、初期表示を妨げないようにする。
    */}
    {analytics.ga4MeasurementId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4MeasurementId}`}
        />
        {/*
          define:vars を使うとAstroがスクリプトをIIFEで包むため、
          gtag をグローバルに出すには window へ明示的に代入する必要がある。
          （今後カスタムイベントを送るときに window.gtag が必要になる）
        */}
        <script is:inline define:vars={{ gaId: analytics.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', gaId);
        </script>
      </>
    )}
  </body>
</html>
