---
import PageLayout from '../../layouts/PageLayout.astro';
import { services } from '../../data/taxonomy';
import { contact } from '../../site.config';

const topics = [
  ...services.map((s) => ({ value: s.id, label: s.name })),
  { value: 'organize', label: 'どこから手を付けるべきか整理したい' },
  { value: 'local', label: '茨城・地域のプロジェクトを一緒に進めたい' },
  { value: 'other', label: 'その他' },
];
---

<PageLayout
  title="お問い合わせ｜シクミベース"
  description="Web・集客・AI活用・業務改善についてのご相談を受け付けています。依頼内容が固まっていない段階でも、何から始めるべきかを一緒に整理します。"
  kicker="CONTACT"
  heading="何から始めるか、一緒に整理します。"
  lead="依頼内容が固まっていなくても大丈夫です。いまの状況を伺ったうえで、Web・集客・業務改善のどこから手を付けるとよいかを整理するところから始めます。"
  crumbs={[{ label: 'ホーム', href: '/' }, { label: 'お問い合わせ' }]}
>
  <div class="wrap body">
    <form class="form" id="contact-form" novalidate>
      <div class="field">
        <label for="topic">ご相談の種類<span class="req">必須</span></label>
        <select id="topic" name="topic" required>
          <option value="">選択してください</option>
          {topics.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="name">お名前<span class="req">必須</span></label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="company">会社名・屋号<span class="opt">任意</span></label>
        <input type="text" id="company" name="company" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="email">メールアドレス<span class="req">必須</span></label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="message">ご相談内容<span class="req">必須</span></label>
        <textarea id="message" name="message" rows="8" required
          placeholder="現在の状況や、困っていることをお書きください。まとまっていない状態でも構いません。"></textarea>
      </div>

      <div class="field field--check">
        <label class="check">
          <input type="checkbox" id="agree" name="agree" required />
          <span>
            <a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>
            に同意します<span class="req">必須</span>
          </span>
        </label>
      </div>

      {/* スパム対策。人間には見えず、埋まっていたら送信を弾く。 */}
      <div class="honeypot" aria-hidden="true">
        <label for="website">サイトURL（入力しないでください）</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <p class="form__error" id="form-error" role="alert" hidden></p>

      <button class="btn btn--primary form__submit" type="submit">
        送信する<span class="btn__arrow" aria-hidden="true">→</span>
      </button>

      <p class="form__note">
        通常2営業日以内にご返信します。返信が届かない場合は迷惑メールフォルダをご確認ください。
      </p>
    </form>

    <aside class="side">
      <section class="side__block">
        <h2 class="side__title">こんなご相談から</h2>
        <ul class="side__list">
          <li>ホームページを作り直したい</li>
          <li>SNSやWeb集客を改善したい</li>
          <li>AIを使って日々の業務を効率化したい</li>
          <li>Web・集客・業務のどこから手を付けるべきか整理したい</li>
          <li>茨城や地域に関するプロジェクトを一緒に進めたい</li>
        </ul>
      </section>

      <section class="side__block">
        <h2 class="side__title">お約束</h2>
        <ul class="side__list side__list--check">
          <li>相談の段階で費用はかかりません</li>
          <li>無理に契約をおすすめすることはありません</li>
          <li>お受けできない場合は、その理由をお伝えします</li>
        </ul>
      </section>

      {contact.email && (
        <section class="side__block">
          <h2 class="side__title">フォームが使えない場合</h2>
          <p class="side__text">
            メールでも受け付けています。<br />
            <a href={`mailto:${contact.email}`} data-cta="contact-email">{contact.email}</a>
          </p>
        </section>
      )}

      <section class="side__block side__block--note">
        <p>
          シクミベースは、山野辺 雄太が個人で運営する事業ブランドです（法人化前）。
          ご相談内容は、返信と提案の検討以外の目的には使用しません。
        </p>
      </section>
    </aside>
  </div>
</PageLayout>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.8fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    padding-top: clamp(36px, 4.5vw, 56px);
  }

  .form {
    display: grid;
    gap: 22px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    font-size: var(--fs-body-sm);
    font-weight: 700;
    color: var(--navy);
  }

  .req,
  .opt {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: 0.625rem;
    font-weight: 700;
    vertical-align: middle;
  }

  .req {
    background: var(--blue);
    color: #fff;
  }

  .opt {
    background: var(--sky);
    color: var(--blue-ink);
  }

  input[type='text'],
  input[type='email'],
  select,
  textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-body-sm);
    line-height: 1.7;
    transition: border-color 0.2s var(--ease);
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--blue);
  }

  textarea {
    resize: vertical;
  }

  input[aria-invalid='true'],
  select[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #c0392b;
  }

  .field--check label {
    font-weight: 400;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--fs-body-sm);
    color: var(--text);
    cursor: pointer;
  }

  .check input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    flex: none;
    accent-color: var(--blue);
  }

  .check a {
    color: var(--blue-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form__error {
    padding: 14px 18px;
    border-radius: var(--radius);
    background: #fdecea;
    border: 1px solid #f5c6c2;
    color: #a32b1c;
    font-size: var(--fs-body-sm);
  }

  .form__submit {
    justify-self: start;
    min-width: 220px;
  }

  .form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .form__note {
    font-size: 0.8125rem;
    color: var(--text-mute);
  }

  .side {
    display: grid;
    gap: 22px;
    padding: clamp(22px, 2.6vw, 30px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sky-soft);
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .side__title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--navy);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-strong);
  }

  .side__list {
    display: grid;
    gap: 9px;
    margin-top: 14px;
  }

  .side__list li {
    position: relative;
    padding-left: 18px;
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--text-mute);
  }

  .side__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 8px;
    height: 2px;
    background: var(--gold);
  }

  .side__list--check li::before {
    content: '✓';
    top: 0;
    width: auto;
    height: auto;
    background: none;
    color: var(--blue);
    font-weight: 700;
  }

  .side__text {
    margin-top: 14px;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--text-mute);
  }

  .side__text a {
    color: var(--blue-ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-all;
  }

  .side__block--note {
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
    font-size: 0.75rem;
    line-height: 1.85;
    color: var(--text-mute);
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
    }

    .form__submit {
      justify-self: stretch;
    }
  }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    if (!form) return;

    const errorBox = document.getElementById('form-error');
    const submit = form.querySelector('button[type="submit"]');
    const track = (name, params) => {
      if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
    };

    // URLの ?topic= を初期選択に反映し、どのCTAから来たかを引き継ぐ
    const topicParam = new URLSearchParams(location.search).get('topic');
    const topicField = form.querySelector('#topic');
    if (topicParam && topicField) {
      const match = [...topicField.options].find((o) => o.value === topicParam);
      if (match) topicField.value = topicParam;
    }

    // 最初の入力で form_start を1度だけ送る
    let started = false;
    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      track('form_start', { form_id: 'contact', topic: topicField ? topicField.value : '' });
    });

    const showError = (message) => {
      errorBox.textContent = message;
      errorBox.hidden = false;
      errorBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.hidden = true;

      // ブラウザ標準の検証を使い、最初の不備にフォーカスする
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      if (!form.checkValidity()) {
        const invalid = form.querySelector(':invalid');
        if (invalid) {
          invalid.setAttribute('aria-invalid', 'true');
          invalid.focus();
        }
        showError('未入力の項目があります。内容をご確認ください。');
        return;
      }

      submit.disabled = true;
      submit.textContent = '送信中…';

      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          throw new Error(body.message || '送信に失敗しました');
        }

        track('generate_lead', { form_id: 'contact', topic: data.topic });
        location.href = '/contact/thanks/';
      } catch (error) {
        showError(
          '送信できませんでした。時間をおいて再度お試しいただくか、メールでご連絡ください。'
        );
        submit.disabled = false;
        submit.innerHTML = '送信する<span class="btn__arrow" aria-hidden="true">→</span>';
      }
    });
  })();
</script>
