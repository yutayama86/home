---
import PageLayout from '../../layouts/PageLayout.astro';
import { services } from '../../data/taxonomy';
import { contact } from '../../site.config';

const topics = [
  { value: 'system', label: 'どこから仕組み化すべきか整理したい' },
  ...services.map((s) => ({ value: s.id, label: s.name })),
  { value: 'local', label: '茨城・地域のプロジェクトを相談したい' },
  { value: 'other', label: 'その他' },
];

const turnstileSiteKey = '0x4AAAAAAEmB3I5NAyMoIF6c';
---

<PageLayout
  title="お問い合わせ｜シクミベース"
  description="集客・営業・発信・業務の仕組み化についてのご相談窓口です。Web・SNS・AIありきではなく、現在の課題と改善優先順位から整理します。"
  kicker="CONTACT"
  heading="どこを仕組みにすると、一番効果が大きいか。"
  lead="課題がまだ整理できていなくても構いません。現在の集客・営業・発信・業務の状態を伺い、最初に手を付けるべき場所を整理します。"
  crumbs={[{ label: 'ホーム', href: '/' }, { label: 'お問い合わせ' }]}
>
  <div class="wrap body">
    <form class="form" id="contact-form" method="post" action="/api/contact" novalidate data-fallback-email={contact.email ?? ''}>
      <div class="field">
        <label for="topic">ご相談の種類<span class="req">必須</span></label>
        <select id="topic" name="topic" required>
          <option value="">選択してください</option>
          {topics.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="name">お名前<span class="req">必須</span></label>
        <input type="text" id="name" name="name" required maxlength="100" autocomplete="name" />
      </div>

      <div class="field">
        <label for="company">会社名・屋号<span class="req">必須</span></label>
        <input type="text" id="company" name="company" required maxlength="200" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="email">メールアドレス<span class="req">必須</span></label>
        <input type="email" id="email" name="email" required maxlength="254" autocomplete="email" />
      </div>

      <div class="field">
        <label for="companyUrl">WebサイトURL<span class="opt">任意</span></label>
        <input type="url" id="companyUrl" name="companyUrl" maxlength="500" inputmode="url" autocomplete="url" />
      </div>

      <div class="field">
        <label for="message">ご相談内容<span class="req">必須</span></label>
        <textarea
          id="message"
          name="message"
          rows="9"
          required
          maxlength="5000"
          placeholder="例：社長に営業や確認業務が集中している／Webから問い合わせを増やしたい／SNS運用を属人化させたくない／AIを業務に組み込みたい、など"
        ></textarea>
      </div>

      <div class="field field--check">
        <label class="check">
          <input type="checkbox" id="agree" name="agree" required />
          <span><a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意します<span class="req">必須</span></span>
        </label>
      </div>

      <div class="honeypot" aria-hidden="true">
        <label for="website">サイトURL（入力しないでください）</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="security-check">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="light" data-language="ja"></div>
        <p>迷惑送信を防ぐため、Cloudflareによる安全確認を行います。</p>
      </div>

      <div class="form__error" id="form-error" role="alert" hidden></div>

      <button class="btn btn--primary form__submit" type="submit">
        内容を送信する<span class="btn__arrow" aria-hidden="true">→</span>
      </button>
      <p class="form__note">通常2営業日以内を目安にご返信します。</p>
    </form>

    <aside class="side">
      <section class="side__block">
        <h2 class="side__title">主なご相談</h2>
        <ul class="side__list">
          <li>社長や一部の担当者に仕事が集中している</li>
          <li>紹介・人脈・個人営業への依存を減らしたい</li>
          <li>WebやSNSを事業成果につながる仕組みにしたい</li>
          <li>AIや自動化を業務フローに組み込みたい</li>
          <li>成果が出た方法を標準化して残したい</li>
        </ul>
      </section>

      <section class="side__block">
        <h2 class="side__title">進め方</h2>
        <ol class="side__steps">
          <li><strong>01 整理</strong><span>課題とボトルネックを確認</span></li>
          <li><strong>02 設計</strong><span>仕組みにする範囲を決定</span></li>
          <li><strong>03 実装</strong><span>必要な手段だけ導入</span></li>
          <li><strong>04 改善</strong><span>数字を見て継続改善</span></li>
        </ol>
      </section>

      {contact.email && (
        <section class="side__block">
          <h2 class="side__title">メールでのご相談</h2>
          <p class="side__text"><a href={`mailto:${contact.email}`} data-cta="contact-email">{contact.email}</a></p>
        </section>
      )}

      <section class="side__block side__block--note">
        <p>シクミベースは、山野辺 雄太が個人で運営する事業ブランドです（法人化前）。</p>
      </section>
    </aside>
  </div>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    (() => {
      const form = document.getElementById('contact-form');
      const errorBox = document.getElementById('form-error');
      if (!(form instanceof HTMLFormElement) || !(errorBox instanceof HTMLElement)) return;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.hidden = true;
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        const submit = form.querySelector('button[type="submit"]');
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error('send_failed');
          window.location.href = '/contact/thanks/';
        } catch {
          errorBox.textContent = '送信できませんでした。時間をおいて再度お試しいただくか、メールでご連絡ください。';
          errorBox.hidden = false;
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      });
    })();
  </script>
</PageLayout>

<style>
  .body { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(260px,.75fr); gap: clamp(32px,5vw,64px); align-items: start; padding-top: clamp(36px,4.5vw,56px); }
  .form { display: grid; gap: 22px; }
  .field { display: grid; gap: 8px; }
  .field label { font-size: var(--fs-body-sm); font-weight: 700; color: var(--navy); }
  .req,.opt { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: var(--radius-pill); font-size: .625rem; font-weight: 700; vertical-align: middle; }
  .req { background: var(--blue); color: #fff; }
  .opt { background: var(--sky); color: var(--blue-ink); }
  input[type='text'],input[type='email'],input[type='url'],select,textarea { width: 100%; padding: 14px 16px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--paper); color: var(--text); font: inherit; font-size: var(--fs-body-sm); line-height: 1.7; }
  input:focus,select:focus,textarea:focus { border-color: var(--blue); outline: 2px solid color-mix(in srgb,var(--blue) 18%,transparent); }
  textarea { resize: vertical; }
  .field--check label { font-weight: 400; }
  .check { display: flex; align-items: flex-start; gap: 10px; }
  .check input { margin-top: .45em; }
  .check a,.side a { color: var(--blue-ink); text-decoration: underline; text-underline-offset: 3px; }
  .honeypot { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  .security-check { display: grid; gap: 8px; }
  .security-check p,.form__note { font-size: .75rem; color: var(--text-mute); }
  .form__error { padding: 14px 16px; border-left: 3px solid #b42318; background: #fff1f0; color: #7a271a; font-size: var(--fs-body-sm); }
  .form__submit { width: fit-content; }
  .form__submit:disabled { opacity: .55; cursor: wait; }
  .side { display: grid; gap: 20px; }
  .side__block { padding: 22px 24px; border: 1px solid var(--line); background: var(--paper); }
  .side__title { font-size: 1rem; color: var(--navy); }
  .side__list { display: grid; gap: 10px; margin-top: 16px; }
  .side__list li { position: relative; padding-left: 18px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .side__list li::before { content: ''; position: absolute; left: 0; top: .75em; width: 8px; height: 2px; background: var(--gold); }
  .side__steps { display: grid; gap: 12px; margin-top: 16px; }
  .side__steps li { display: grid; gap: 2px; }
  .side__steps strong { font-size: .75rem; color: var(--blue-ink); }
  .side__steps span { font-size: var(--fs-body-sm); color: var(--text-mute); }
  .side__text { margin-top: 10px; font-size: var(--fs-body-sm); }
  .side__block--note { border-left: 3px solid var(--gold); }
  .side__block--note p { font-size: .75rem; color: var(--text-mute); }
  @media (max-width: 820px) { .body { grid-template-columns: 1fr; } .form__submit { width: 100%; } }
</style>
