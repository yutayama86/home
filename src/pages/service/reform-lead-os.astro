---
import PageLayout from '../../layouts/PageLayout.astro';
import { ctaHref, site } from '../../site.config';

const included = [
  '対象とする営業フロー1本の設計',
  '既存問い合わせフォームの改善',
  '写真・場所・希望時期など現調前情報の回収',
  '5分以内を目標とする受信確認',
  '問い合わせの案件台帳への自動登録',
  '担当者・案件段階・次回行動日の管理',
  '未対応・期限超過の通知',
  '見積提出後3回のフォローテンプレートと運用',
  'GA4・Search Console・営業段階をつなぐKPI画面',
  '操作動画・60分研修・30日間の安定化支援',
];

const fit = [
  '外壁塗装・屋根・住宅リフォームを扱っている',
  '一般のお客様から直接受注している',
  'Web・LINE等から月10件以上の反響がある',
  '平均工事単価80万円以上を目安にしている',
  '案件管理が紙・Excel・担当者に分散している',
  '過去90日の反響・現調・見積・受注数を確認できる',
  '社長または担当責任者が設計と検収に参加できる',
];

const notFit = [
  '下請・公共工事中心で、一般のお客様からの反響がない',
  '問い合わせ自体がほぼない',
  '基幹・会計システムの全面刷新を求めている',
  '成果報酬、売上保証、無制限修正を求めている',
  '必要な数字やアクセス権限を共有できない',
  '意思決定者が設計・検収に参加できない',
];

const process = [
  { days: 'DAY 1–3', title: '現状確認', body: '問い合わせ経路、対応手順、利用ツール、過去90日の数字を確認します。' },
  { days: 'DAY 4–10', title: '設計', body: '対象フロー、必要項目、通知、担当者、人の承認箇所を確定します。' },
  { days: 'DAY 11–24', title: '実装・テスト', body: 'フォーム、台帳、自動返信、通知、追客、計測を設定します。' },
  { days: 'DAY 25–30', title: '検収・引き継ぎ', body: '動作確認、操作動画、研修を行い、社内で再現できる状態にします。' },
];

const acceptance = [
  'テスト問い合わせに5分以内で受信確認が届く',
  '対象問い合わせが案件台帳へ登録される',
  '未対応案件と次回行動日を確認できる',
  '合意した見積フォローが予定どおり動く',
  '顧客担当者が操作手順を再現できる',
];

const excluded = [
  'サイト全面リニューアル',
  '広告運用',
  'SNSの日次投稿代行',
  'SEO順位保証',
  '電話対応の完全自動化',
  '会計・基幹システム刷新',
  '無制限の個別開発',
  '外部サービス利用料',
];

const faqs = [
  {
    q: '既存のホームページを作り直す必要はありますか？',
    a: 'ありません。現在のサイトを活かせる場合は、フォームや導線など必要な部分だけを改善します。全面リニューアルは本サービスの対象外です。',
  },
  {
    q: 'AIやITの知識は必要ですか？',
    a: '必要ありません。担当者が日常業務で再現できる手順にし、操作動画と研修を提供します。',
  },
  {
    q: '売上や受注件数は増えますか？',
    a: '売上や受注を保証するサービスではありません。反響への対応速度、未対応数、次回行動日の設定率、追客実施率など、受注前の運用品質を改善・計測します。',
  },
  {
    q: '問い合わせが月10件未満でも依頼できますか？',
    a: '有料診断は可能です。ただし、反響不足が主な課題の場合は本サービスを勧めず、先に集客や導線の改善をご案内することがあります。',
  },
  {
    q: '30日で必ず完成しますか？',
    a: '必要なアクセス権限と確認回答が予定どおり提供されることを前提に進めます。顧客側の確認遅延や外部サービス障害がある場合は、日程を再調整します。',
  },
  {
    q: '顧客情報をAIに入力しますか？',
    a: '個人情報、原価、機密情報を無制限にAIへ入力しません。見積金額、契約判断、重要な顧客連絡は必ず人が確認・承認します。',
  },
  {
    q: '最初から99万円の契約が必要ですか？',
    a: 'いいえ。最初に税別55,000円の診断で現状と実装範囲を確定します。実装をご契約の場合、診断料は実装費から控除します。',
  },
  {
    q: 'どのツールを使いますか？',
    a: '現在利用しているサイト、メール、LINE、Google環境などを確認し、必要最小限の構成を選びます。外部サービスの利用料は顧客の直接契約です。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'リフォーム反響OS 30',
      serviceType: '住宅リフォーム会社向け反響対応・見積フォローの業務設計と実装',
      description: '問い合わせへの受信確認、現調前情報回収、案件台帳、見積後3回のフォロー、KPI計測を30日で本番稼働させるサービスです。',
      url: new URL('/service/reform-lead-os/', site.url).href,
      areaServed: { '@type': 'AdministrativeArea', name: '茨城県および近隣地域' },
      audience: { '@type': 'BusinessAudience', audienceType: '外壁塗装・屋根・住宅リフォーム会社' },
      provider: { '@type': 'Organization', name: site.name, url: site.url },
      offers: [
        { '@type': 'Offer', name: '共同検証・1社目', price: '330000', priceCurrency: 'JPY' },
        { '@type': 'Offer', name: '共同検証・2社目', price: '550000', priceCurrency: 'JPY' },
        { '@type': 'Offer', name: '標準価格', price: '990000', priceCurrency: 'JPY' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<PageLayout
  title="リフォーム反響OS 30｜問い合わせ・見積フォローを30日で仕組み化"
  description="外壁塗装・屋根・住宅リフォーム会社向けに、問い合わせへの受信確認、現調前情報回収、案件台帳、見積後3回のフォロー、KPI計測を30日で本番稼働させます。"
  showHeader={false}
  crumbs={[
    { label: 'ホーム', href: '/' },
    { label: 'サービス', href: '/service/' },
    { label: 'リフォーム反響OS 30' },
  ]}
>
  <section class="product-hero">
    <div class="wrap product-hero__inner">
      <div class="product-hero__body reveal">
        <p class="kicker">住宅リフォーム会社向け 反響対応・追客の仕組み化</p>
        <h1>問い合わせが来たあとを、<br /><em>30日で仕組みにする。</em></h1>
        <p class="product-hero__lead">
          新しいツールを導入することが目的ではありません。現在のサイト、メール、LINE、Google環境を活かしながら、
          ひとつの営業フローを設計・実装・検証し、担当者が運用できる状態まで整えます。
        </p>
        <div class="product-hero__actions">
          <a
            class="btn btn--primary"
            href={ctaHref('reform-audit')}
            data-cta="product-hero-audit"
            data-cta-topic="reform-audit"
          >
            有料診断から始める<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="#price" data-cta="product-hero-price">価格と対象範囲を見る</a>
        </div>
        <p class="product-hero__note">
          診断料は税別55,000円。実装をご契約の場合は同額を実装費から控除します。
        </p>
      </div>

      <aside class="product-hero__panel reveal" data-delay="1">
        <p class="product-hero__panel-label">REFORM LEAD OS 30</p>
        <h2>反響から追客まで、<br />対象フローは1本。</h2>
        <ol>
          <li><span>01</span>新規反響の受信確認</li>
          <li><span>02</span>現調前情報の回収</li>
          <li><span>03</span>案件台帳と未対応通知</li>
          <li><span>04</span>見積後3回のフォロー</li>
          <li><span>05</span>KPI計測と改善</li>
        </ol>
        <p>見積・契約・重要な顧客連絡は、人が判断します。</p>
      </aside>
    </div>
  </section>

  <section class="section product-section" id="included">
    <div class="wrap narrow">
      <div class="section-head reveal">
        <p class="kicker">実装範囲<span>WHAT IS INCLUDED</span></p>
        <h2 class="section-title">30日で、本番稼働させるもの。</h2>
        <p class="section-lead measure">
          設計書を渡して終わりではありません。実装、テスト、操作動画、研修、安定化までをひとつの契約範囲にします。
        </p>
      </div>

      <ol class="included-grid">
        {included.map((item, index) => (
          <li class="included-item reveal" data-delay={String(index % 4)}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section audience-section">
    <div class="wrap audience-grid">
      <div class="audience reveal">
        <p class="audience__label audience__label--fit">向いている会社</p>
        <h2>運用改善の効果を、<br />数字で確かめられる。</h2>
        <ul>
          {fit.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="audience audience--no reveal" data-delay="1">
        <p class="audience__label">対象外になる会社</p>
        <h2>契約前に、<br />合わない条件も明示します。</h2>
        <ul>
          {notFit.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section process-section on-dark" id="process">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">30日の進行<span>PROCESS</span></p>
        <h2 class="section-title">現状確認から、社内で再現できる状態まで。</h2>
      </div>

      <ol class="process-grid">
        {process.map((item, index) => (
          <li class="process-card reveal" data-delay={String(index)}>
            <span>{item.days}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>

      <p class="process-section__note reveal">
        必要なアクセス権限と確認回答が予定どおり提供されることが前提です。顧客側の確認遅延や外部サービス障害がある場合は日程を再調整します。
      </p>
    </div>
  </section>

  <section class="section acceptance-section">
    <div class="wrap acceptance-grid">
      <div class="acceptance__body reveal">
        <p class="kicker">検収基準<span>ACCEPTANCE</span></p>
        <h2 class="section-title">売上ではなく、<br />「動く状態」を約束します。</h2>
        <p class="section-lead">
          売上、受注件数、SEO順位は保証しません。実装の完了は、事前に合意した動作と担当者の再現性で判定します。
        </p>
      </div>

      <div class="acceptance__panel reveal" data-delay="1">
        <p class="acceptance__panel-title">合格条件</p>
        <ul>
          {acceptance.map((item) => <li>{item}</li>)}
        </ul>
        <p class="acceptance__promise">
          当方の責任で30日以内に上記を満たさない場合、後半50％を請求せず、検収まで追加費用なしで対応します。
        </p>
      </div>
    </div>
  </section>

  <section class="section price-section" id="price">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">価格<span>PRICE</span></p>
        <h2 class="section-title">最初は診断で、実装範囲を確定。</h2>
        <p class="section-lead measure">
          共同検証枠は、導入前後の数値計測、事例公開、推薦コメントへの協力を条件にした初期2社の価格です。
        </p>
      </div>

      <div class="price-grid">
        <article class="price-card price-card--entry reveal">
          <p class="price-card__eyebrow">導入前</p>
          <h3>見積フォロー漏れ診断</h3>
          <p class="price-card__price"><strong>55,000</strong><span>円／税別</span></p>
          <p>実装契約時は、同額を実装費から控除します。</p>
          <a href="/diagnosis/reform-lead/" data-cta="product-price-audit">診断の内容を見る →</a>
        </article>

        <article class="price-card reveal" data-delay="1">
          <p class="price-card__eyebrow">共同検証・1社目</p>
          <h3>リフォーム反響OS 30</h3>
          <p class="price-card__price"><strong>330,000</strong><span>円／税別</span></p>
          <p>数値計測、事例公開、推薦コメントへの協力が条件です。</p>
        </article>

        <article class="price-card reveal" data-delay="2">
          <p class="price-card__eyebrow">共同検証・2社目</p>
          <h3>リフォーム反響OS 30</h3>
          <p class="price-card__price"><strong>550,000</strong><span>円／税別</span></p>
          <p>数値計測、事例公開、推薦コメントへの協力が条件です。</p>
        </article>

        <article class="price-card price-card--standard reveal" data-delay="3">
          <p class="price-card__eyebrow">3社目以降</p>
          <h3>標準価格</h3>
          <p class="price-card__price"><strong>990,000</strong><span>円／税別</span></p>
          <p>対象フロー1本と、掲載した実装・検収範囲を含みます。</p>
        </article>
      </div>

      <p class="price-section__note reveal">
        共同検証枠の受付状況は、申込時にご案内します。価格を下げる必要がある場合は、値引きではなく対象機能を減らして見積もります。
      </p>
    </div>
  </section>

  <section class="section care-section">
    <div class="wrap care-grid">
      <div class="care__body reveal">
        <p class="kicker">稼働後の改善<span>CONTINUOUS CARE</span></p>
        <h2 class="section-title">動かしたあとも、<br />止めずに改善する。</h2>
        <p class="section-lead">
          稼働監視、KPIの確認、軽微改善、テンプレート改善を月次で続けます。最低契約期間は3か月です。
        </p>
      </div>

      <dl class="care__plans reveal" data-delay="1">
        <div>
          <dt>共同検証枠</dt>
          <dd><strong>99,000円</strong><span>／月・税別</span></dd>
        </div>
        <div>
          <dt>標準価格</dt>
          <dd><strong>165,000円</strong><span>／月・税別</span></dd>
        </div>
        <p>
          稼働監視、月次KPIレポート、軽微改善2件、返信・追客テンプレート改善、エラー一次対応、月1回45分の改善会議を含みます。
        </p>
      </dl>
    </div>
  </section>

  <section class="section excluded-section">
    <div class="wrap excluded-grid">
      <div class="excluded__head reveal">
        <p class="kicker">対象外<span>NOT INCLUDED</span></p>
        <h2 class="section-title">やらないことも、<br />最初に決めます。</h2>
      </div>
      <ul class="excluded__list reveal" data-delay="1">
        {excluded.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section faq-section" id="faq">
    <div class="wrap faq-wrap">
      <div class="section-head reveal">
        <p class="kicker">よくある質問<span>FAQ</span></p>
        <h2 class="section-title">契約前に、曖昧さを残さない。</h2>
      </div>

      <div class="faq-list reveal">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta on-dark">
    <div class="wrap final-cta__inner reveal">
      <div>
        <p class="kicker">最初の一歩<span>START</span></p>
        <h2>いきなり実装契約を、<br />決める必要はありません。</h2>
        <p>
          まず現在の反響経路と見積フォローを確認し、実装すべき場所、対象外にする場所、固定見積を明らかにします。
        </p>
      </div>
      <div class="final-cta__action">
        <p><strong>55,000円</strong><span>／税別</span></p>
        <a
          class="btn btn--on-dark"
          href={ctaHref('reform-audit')}
          data-cta="product-final-audit"
          data-cta-topic="reform-audit"
        >
          診断の適合確認を申し込む<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <small>対象条件と実施内容の確認後に正式受付</small>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'view_offer', {
          offer_id: 'reform-lead-os-30',
          offer_type: 'implementation',
        });
      }
    });
  </script>
</PageLayout>

<style>
  .narrow {
    max-width: calc(1040px + var(--gutter) * 2);
  }

  .section-head {
    max-width: 52em;
  }

  .section-head .kicker span,
  .acceptance__body .kicker span,
  .care__body .kicker span,
  .excluded__head .kicker span,
  .final-cta .kicker span {
    margin-left: 8px;
    color: inherit;
    opacity: 0.7;
  }

  .product-hero {
    padding-block: clamp(38px, 6vw, 88px);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .product-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }

  .product-hero h1 {
    margin-top: 18px;
    font-size: clamp(2.5rem, 1.55rem + 4vw, 5rem);
    line-height: 1.22;
    color: var(--navy);
  }

  .product-hero h1 em {
    font-style: normal;
    color: var(--blue);
  }

  .product-hero__lead {
    max-width: 40em;
    margin-top: 24px;
    font-size: var(--fs-lead);
    color: var(--text-mute);
  }

  .product-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .product-hero__note {
    margin-top: 14px;
    font-size: 0.75rem;
    color: var(--text-mute);
  }

  .product-hero__panel {
    padding: clamp(26px, 3vw, 36px);
    border-top: 4px solid var(--gold);
    background: var(--navy);
    color: #fff;
  }

  .product-hero__panel-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-on-dark-mute);
  }

  .product-hero__panel h2 {
    margin-top: 10px;
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
  }

  .product-hero__panel ol {
    margin-top: 22px;
    border-top: 1px solid var(--line-on-dark);
  }

  .product-hero__panel li {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-on-dark);
    font-size: var(--fs-body-sm);
  }

  .product-hero__panel li span {
    font-size: 0.625rem;
    color: var(--gold);
  }

  .product-hero__panel > p:last-child {
    margin-top: 18px;
    font-size: 0.75rem;
    color: var(--text-on-dark-mute);
  }

  .product-section {
    background: var(--sky-soft);
  }

  .included-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(38px, 5vw, 60px);
    border: 1px solid var(--line-strong);
    background: var(--line-strong);
  }

  .included-item {
    display: grid;
    grid-template-columns: 34px 1fr;
