---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { services, getService, categories } from '../../data/taxonomy';
import { publishedSorted, publishedCases } from '../../utils/related';
import { ctaHref, site } from '../../site.config';

export async function getStaticPaths() {
  const knowledge = publishedSorted(await getCollection('knowledge'));
  const cases = publishedCases(await getCollection('case'));

  return services.map((service) => ({
    params: { id: service.id },
    props: {
      service,
      articles: knowledge.filter((a) => a.data.relatedServices.includes(service.id)).slice(0, 6),
      cases: cases.filter((c) => c.data.relatedServices.includes(service.id)),
    },
  }));
}

const { service, articles, cases } = Astro.props;
const s = getService(service.id);
const otherServices = services.filter((x) => x.id !== s.id);
const relatedCategories = categories.filter((c) => c.primaryService === s.id);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  description: s.summary,
  serviceType: s.name,
  areaServed: { '@type': 'Country', name: '日本' },
  provider: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  url: new URL(`/service/${s.id}/`, site.url).href,
};
---

<PageLayout
  title={`${s.name}｜シクミベース`}
  description={s.summary}
  kicker={s.en}
  heading={s.name}
  lead={s.summary}
  crumbs={[
    { label: 'ホーム', href: '/' },
    { label: 'サービス', href: '/service/' },
    { label: s.name },
  ]}
>
  <div class="wrap body">
    <section class="block">
      <h2 class="block__title">こんな課題に向いています</h2>
      <ul class="problems">
        {s.problems.map((problem) => (
          <li class="problem">{problem}</li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">支援すること</h2>
      <ul class="deliverables">
        {s.deliverables.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">目指す状態</h2>
      <p class="outcome">{s.outcome}</p>
    </section>

    <section class="block cta-block">
      <h2 class="cta-block__title">まずは現状を整理するところから</h2>
      <p class="cta-block__lead">
        依頼内容が固まっていなくても大丈夫です。いまの状況と困っていることを伺い、
        着手する順番を一緒に整理します。無理に受注につなげることはしません。
      </p>
      <a class="btn btn--primary" href={ctaHref(s.id)} data-cta="service-page" data-cta-topic={s.id}>
        {s.ctaLabel}<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </section>

    {cases.length > 0 && (
      <section class="block">
        <h2 class="block__title">関連する事例</h2>
        <ul class="cases">
          {cases.map((item) => (
            <li>
              <a class="case-link" href={`/case/${item.id}/`}>
                <span class="case-link__title">{item.data.title}</span>
                <span class="case-link__desc">{item.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {articles.length > 0 && (
      <section class="block">
        <h2 class="block__title">関連するナレッジ</h2>
        <div>
          {articles.map((article) => (
            <ArticleCard
              href={`/knowledge/${article.data.category}/${article.id}/`}
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              publishedAt={article.data.publishedAt}
              updatedAt={article.data.updatedAt}
              firstParty={article.data.firstParty}
            />
          ))}
        </div>
        {relatedCategories.length > 0 && (
          <p class="more">
            {relatedCategories.map((c) => (
              <a href={`/knowledge/${c.id}/`}>{c.name}の記事をすべて見る →</a>
            ))}
          </p>
        )}
      </section>
    )}

    <nav class="others" aria-label="他のサービス">
      <p class="others__title">他のサービス</p>
      <ul>
        {otherServices.map((other) => (
          <li>
            <a class="other" href={`/service/${other.id}/`}>
              <span class="other__name">{other.name}</span>
              <span class="other__summary">{other.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</PageLayout>

<style>
  .body {
    max-width: calc(860px + var(--gutter) * 2);
    padding-top: clamp(36px, 4.5vw, 56px);
  }

  .block + .block {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .block__title {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    color: var(--navy);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--navy);
    margin-bottom: 22px;
  }

  .problems {
    display: grid;
    gap: 10px;
  }

  .problem {
    position: relative;
    padding: 14px 18px 14px 44px;
    background: var(--sky-soft);
    border-radius: var(--radius);
    font-weight: 700;
    color: var(--navy);
  }

  .problem::before {
    content: '✓';
    position: absolute;
    left: 18px;
    color: var(--blue);
  }

  .deliverables {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px;
  }

  .deliverables li {
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    font-size: var(--fs-body-sm);
  }

  .outcome {
    padding: 20px 24px;
    border-left: 3px solid var(--gold);
    background: var(--paper);
    font-size: var(--fs-lead);
    color: var(--navy);
  }

  .cta-block {
    padding: clamp(28px, 3.5vw, 44px);
    border-radius: var(--radius);
    background: var(--navy);
    color: #fff;
  }

  .cta-block__title {
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.625rem);
  }

  .cta-block__lead {
    margin-top: 14px;
    font-size: var(--fs-body-sm);
    color: var(--text-on-dark-mute);
  }

  .cta-block .btn {
    margin-top: 24px;
    background: #fff;
    border-color: #fff;
    color: var(--navy);
  }

  .cta-block .btn:hover {
    background: var(--sky);
    border-color: var(--sky);
  }

  .cases {
    display: grid;
    gap: 12px;
  }

  .case-link {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    transition: border-color 0.25s var(--ease);
  }

  .case-link:hover {
    border-color: var(--blue);
  }

  .case-link__title {
    font-weight: 700;
    color: var(--navy);
  }

  .case-link__desc {
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .more {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .more a {
    font-size: var(--fs-body-sm);
    font-weight: 700;
    color: var(--blue-ink);
  }

  .others {
    margin-top: clamp(48px, 6vw, 72px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .others__title {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: var(--ls-label);
    color: var(--blue-ink);
  }

  .others ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .other {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    transition: border-color 0.25s var(--ease);
  }

  .other:hover {
    border-color: var(--blue);
  }

  .other__name {
    font-weight: 700;
    color: var(--navy);
  }

  .other__summary {
    font-size: 0.8125rem;
    line-height: 1.85;
    color: var(--text-mute);
  }
</style>
