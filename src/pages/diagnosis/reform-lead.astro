---
import PageLayout from '../../layouts/PageLayout.astro';
import { ctaHref, site } from '../../site.config';

const deliverables = [
  '現在の問い合わせ経路図',
  '初回返信までの時間',
  '現調前に不足している情報',
  '案件台帳への転記箇所',
  '見積後のフォロー状況',
  '取りこぼし候補と改善優先順位',
  '30日実装案と固定見積',
];

const required = [
  '現在の問い合わせフォームと受付経路',
  '過去90日の反響・現調・見積・受注数',
  '現在使用している案件台帳',
  '自動返信や見積後フォローの文面',
  '社長または担当責任者のヒアリング参加',
];

const steps = [
  { no: '01', title: '適合確認', body: '申込フォームの内容から、対象条件と対応可否を確認します。' },
  { no: '02', title: '正式受付', body: '実施内容、日程、支払方法をご案内し、合意後に診断料をご入金いただきます。' },
  { no: '03', title: '資料・ヒアリング', body: '既存資料を確認し、社長または担当責任者へ運用実態を伺います。' },
  { no: '04', title: '診断資料を納品', body: '反響経路、停止箇所、改善優先順位、30日実装案、固定見積をお渡しします。' },
  { no: '05', title: '実装を判断', body: '診断内容を見てから、実装するかどうかを顧客側で決められます。' },
];

const faqs = [
  {
    q: '申し込んだ時点で料金が発生しますか？',
    a: 'いいえ。申込内容から対象条件を確認し、実施内容と支払方法をご案内したあとに正式受付となります。診断前にお断りする場合、費用は発生しません。',
  },
  {
    q: '診断後に実装を契約する義務はありますか？',
    a: 'ありません。診断資料は自社の判断材料として利用でき、実装するかどうかは納品後に決められます。',
  },
  {
    q: '診断料は実装費とは別ですか？',
    a: '実装をご契約の場合は、診断料と同額の55,000円を実装費から控除します。',
  },
  {
    q: 'オンラインで実施できますか？',
    a: '資料共有とヒアリングは原則オンラインで進めます。現地確認が必要な場合は、対象範囲と費用を事前に相談します。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: '見積フォロー漏れ診断',
      serviceType: '住宅リフォーム会社向け反響対応・見積フォロー診断',
      description: '問い合わせから現調、見積、受注判断までの流れを確認し、対応が止まる場所と改善順序、30日実装案を納品します。',
      url: new URL('/diagnosis/reform-lead/', site.url).href,
      areaServed: { '@type': 'AdministrativeArea', name: '茨城県および近隣地域' },
      provider: { '@type': 'Organization', name: site.name, url: site.url },
      offers: {
        '@type': 'Offer',
        price: '55000',
        priceCurrency: 'JPY',
        description: '税別。実装契約時は同額を実装費から控除。',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<PageLayout
  title="見積フォロー漏れ診断｜住宅リフォーム会社の反響対応を可視化"
  description="住宅リフォーム会社の問い合わせ、現調、見積、受注判断までを確認し、対応が止まる場所、改善優先順位、30日実装案と固定見積を診断資料として納品します。"
  showHeader={false}
  crumbs={[
    { label: 'ホーム', href: '/' },
    { label: '見積フォロー漏れ診断' },
  ]}
>
  <section class="diagnosis-hero">
    <div class="wrap diagnosis-hero__inner">
      <div class="diagnosis-hero__body reveal">
        <p class="kicker">リフォーム反響OS 30 導入前診断</p>
        <h1>その見積、<br /><em>次に連絡する日が決まっていますか。</em></h1>
        <p class="diagnosis-hero__lead">
          問い合わせが届いてから、現調、見積、受注判断までの流れを確認し、対応が止まる場所と改善順序を整理します。
          無料相談のための提案書ではなく、自社で使える診断資料として納品します。
        </p>

        <div class="diagnosis-hero__actions">
          <a
            class="btn btn--primary"
            href={ctaHref('reform-audit')}
            data-cta="diagnosis-hero-apply"
            data-cta-topic="reform-audit"
          >
            診断の適合確認を申し込む<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="#deliverables" data-cta="diagnosis-hero-deliverables">
            納品物を確認する
          </a>
        </div>
      </div>

      <aside class="price-panel reveal" data-delay="1">
        <p class="price-panel__label">DIAGNOSIS FEE</p>
        <p class="price-panel__name">見積フォロー漏れ診断</p>
        <p class="price-panel__price"><strong>55,000</strong><span>円／税別</span></p>
        <p class="price-panel__credit">実装契約時に同額控除</p>
        <ul>
          <li>申込時点では課金なし</li>
          <li>適合確認後に正式受付</li>
          <li>診断後の実装契約は任意</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section deliverables-section" id="deliverables">
    <div class="wrap deliverables-grid">
      <div class="deliverables__head reveal">
        <p class="kicker">納品物<span>DELIVERABLES</span></p>
        <h2 class="section-title">曖昧な相談ではなく、<br />判断できる資料を残す。</h2>
        <p class="section-lead">
          どこが止まり、どこから直すかを明確にします。実装しない場合も、社内の改善判断に使えます。
        </p>
      </div>

      <ol class="deliverables__list reveal" data-delay="1">
        {deliverables.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section input-section">
    <div class="wrap input-grid">
      <div class="input__head reveal">
        <p class="kicker">診断に必要なもの<span>INPUT</span></p>
        <h2 class="section-title">実態を確認できる資料と、<br />責任者の参加。</h2>
        <p class="section-lead">
          数字や運用を確認できない状態では、精度のある診断はできません。準備が難しい項目は申込時にご相談ください。
        </p>
      </div>

      <ul class="input__list reveal" data-delay="1">
        {required.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section flow-section on-dark">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">進め方<span>FLOW</span></p>
        <h2 class="section-title">申込から、実装判断まで。</h2>
      </div>

      <ol class="flow-list">
        {steps.map((item, index) => (
          <li class="flow-card reveal" data-delay={String(index % 4)}>
            <span>STEP {item.no}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section decision-section">
    <div class="wrap decision-grid">
      <div class="decision__body reveal">
        <p class="kicker">受付条件<span>FIT CHECK</span></p>
        <h2 class="section-title">診断前に、<br />合わない案件を見極めます。</h2>
      </div>

      <div class="decision__panel reveal" data-delay="1">
        <p>
          次のいずれかに当てはまる場合、申込後にお断りすることがあります。その場合、診断前の費用は発生しません。
        </p>
        <ul>
          <li>反響自体がほぼない</li>
          <li>一般のお客様から直接受注していない</li>
          <li>過去の営業数字を確認できない</li>
          <li>社長または担当責任者が参加できない</li>
          <li>売上保証や無料の詳細設計を希望している</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="wrap faq-wrap">
      <div class="section-head reveal">
        <p class="kicker">よくある質問<span>FAQ</span></p>
        <h2 class="section-title">費用と判断のタイミング。</h2>
      </div>

      <div class="faq-list reveal">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta on-dark">
    <div class="wrap final-cta__inner reveal">
      <div>
        <p class="kicker">適合確認<span>APPLY</span></p>
        <h2>実装するかどうかは、<br />診断を見てから決められます。</h2>
        <p>
          申込時点では費用は確定しません。対象条件を確認し、実施内容と支払方法をご案内したあとに正式受付となります。
        </p>
      </div>
      <div class="final-cta__action">
        <p><strong>55,000円</strong><span>／税別</span></p>
        <a
          class="btn btn--on-dark"
          href={ctaHref('reform-audit')}
          data-cta="diagnosis-final-apply"
          data-cta-topic="reform-audit"
        >
          診断の適合確認を申し込む<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="final-cta__product" href="/service/reform-lead-os/">30日実装の詳細を確認する →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'view_offer', {
          offer_id: 'reform-lead-audit',
          offer_type: 'diagnosis',
        });
      }
    });
  </script>
</PageLayout>

<style>
  .section-head {
    max-width: 52em;
  }

  .deliverables__head .kicker span,
  .input__head .kicker span,
  .section-head .kicker span,
  .decision__body .kicker span,
  .final-cta .kicker span {
    margin-left: 8px;
    color: inherit;
    opacity: 0.7;
  }

  .diagnosis-hero {
    padding-block: clamp(38px, 6vw, 88px);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .diagnosis-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }

  .diagnosis-hero h1 {
    margin-top: 18px;
    font-size: clamp(2.4rem, 1.5rem + 3.8vw, 4.8rem);
    line-height: 1.22;
    color: var(--navy);
  }

  .diagnosis-hero h1 em {
    font-style: normal;
    color: var(--blue);
  }

  .diagnosis-hero__lead {
    max-width: 42em;
    margin-top: 24px;
    font-size: var(--fs-lead);
    color: var(--text-mute);
  }

  .diagnosis-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .price-panel {
    padding: clamp(26px, 3.5vw, 40px);
    border-top: 4px solid var(--gold);
    background: var(--navy);
    color: #fff;
  }

  .price-panel__label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-on-dark-mute);
  }

  .price-panel__name {
    margin-top: 12px;
    font-weight: 700;
  }

  .price-panel__price {
    display: grid;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line-on-dark);
  }

  .price-panel__price strong {
    font-size: clamp(2rem, 1.6rem + 1.5vw, 2.75rem);
  }

  .price-panel__price span,
  .price-panel__credit,
  .price-panel li {
    font-size: 0.75rem;
    color: var(--text-on-dark-mute);
  }

  .price-panel__credit {
    margin-top: 6px;
    color: var(--gold);
    font-weight: 700;
  }

  .price-panel ul {
    display: grid;
    gap: 9px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--line-on-dark);
  }

  .price-panel li {
    position: relative;
    padding-left: 20px;
  }

  .price-panel li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gold);
  }

  .deliverables-section {
    background: var(--sky-soft);
  }

  .deliverables-grid,
  .input-grid,
  .decision-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 5vw, 76px);
    align-items: start;
  }

  .deliverables__list {
    border-top: 1px solid var(--line-strong);
  }

  .deliverables__list li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .deliverables__list span {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--blue);
  }

  .deliverables__list p {
    font-size: var(--fs-body-sm);
    font-weight: 700;
    color: var(--navy);
  }

  .input-section {
    background: var(--paper);
  }

  .input__list {
    display: grid;
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .input__list li {
    position: relative;
    padding: 18px 20px 18px 48px;
    background: var(--sky-soft);
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .input__list li::before {
    content: '✓';
    position: absolute;
    left: 20px;
    color: var(--blue);
    font-weight: 700;
  }

  .flow-section {
    background: var(--navy);
  }

  .flow-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(36px, 4.5vw, 56px);
    border: 1px solid var(--line-on-dark);
    background: var(--line-on-dark);
  }

  .flow-card {
    padding: clamp(20px, 2.5vw, 28px);
    background: var(--navy);
  }

  .flow-card > span {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  .flow-card h3 {
    margin-top: 10px;
    font-size: 1.1rem;
  }

  .flow-card p {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--text-on-dark-mute);
  }

  .decision-section {
    background: var(--sky-soft);
  }

  .decision__panel {
    padding: clamp(26px, 3.5vw, 40px);
    background: var(--paper);
    border-top: 4px solid var(--text-mute);
  }

  .decision__panel > p {
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .decision__panel ul {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  .decision__panel li {
    position: relative;
    padding-left: 24px;
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .decision__panel li::before {
    content: '—';
    position: absolute;
    left: 0;
  }

  .faq-section {
    background: var(--paper);
  }

  .faq-wrap {
    max-width: calc(900px + var(--gutter) * 2);
  }

  .faq-list {
    margin-top: clamp(34px, 4.5vw, 54px);
    border-top: 1px solid var(--line-strong);
  }

  .faq-list details {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq-list summary {
    position: relative;
    padding: 20px 56px 20px 4px;
    font-weight: 700;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    content: '+';
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    color: var(--blue);
  }

  .faq-list details[open] summary::after {
    content: '−';
  }

  .faq-list details p {
    padding: 0 56px 22px 4px;
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .final-cta {
    background: var(--navy);
  }

  .final-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: clamp(34px, 5vw, 70px);
    align-items: center;
  }

  .final-cta h2 {
    font-size: var(--fs-h2);
  }

  .final-cta h2 + p {
    max-width: 42em;
    margin-top: 18px;
    color: var(--text-on-dark-mute);
  }

  .final-cta__action {
    display: grid;
    justify-items: start;
    padding: clamp(24px, 3vw, 34px);
    border-top: 3px solid var(--gold);
    background: rgba(255, 255, 255, 0.08);
  }

  .final-cta__action > p {
    margin-bottom: 16px;
  }

  .final-cta__action strong {
    font-size: clamp(1.6rem, 1.25rem + 1.1vw, 2.2rem);
  }

  .final-cta__action span {
    font-size: 0.75rem;
    color: var(--text-on-dark-mute);
  }

  .final-cta__product {
    margin-top: 16px;
    font-size: 0.75rem;
    color: var(--text-on-dark-mute);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .flow-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .diagnosis-hero__inner,
    .deliverables-grid,
    .input-grid,
    .decision-grid,
    .final-cta__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .diagnosis-hero__actions .btn,
    .final-cta__action .btn {
      width: 100%;
    }

    .flow-list {
      grid-template-columns: 1fr;
    }
  }
</style>
