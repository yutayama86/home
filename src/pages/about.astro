---
import PageLayout from '../layouts/PageLayout.astro';
import { site, ctaHref } from '../site.config';
import { services } from '../data/taxonomy';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.operator,
    jobTitle: 'Web Director',
    url: new URL('/about/', site.url).href,
    worksFor: { '@type': 'Organization', name: site.name, url: site.url },
    knowsAbout: ['Web制作', 'SEO', 'SNS運用', 'AI活用', '業務改善', '地域メディア運営'],
  },
};
---

<PageLayout
  title="運営者について｜シクミベース"
  description="シクミベースは、山野辺雄太が個人で運営する事業ブランドです。Web制作・ディレクションを軸に、SEO、SNS運用、AI活用、業務改善までを扱っています。"
  kicker="ABOUT"
  heading="運営者について"
  crumbs={[{ label: 'ホーム', href: '/' }, { label: '運営者について' }]}
>
  <div class="wrap body">
    <section class="profile">
      <figure class="profile__visual">
        <img
          src="/operator-illustration-fresh.jpg"
          alt="Web・マーケティング・地域事業に取り組むシクミベース運営者のイラスト"
          width="1024"
          height="1536"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="profile__body">
        <h2 class="profile__name">{site.operator}</h2>
        <p class="profile__role">Web Director / シクミベース</p>

        <div class="profile__text">
          <p>
            Web制作・ディレクションを中心に、要件定義、SEO、SNS運用、チームの業務改善まで幅広く経験してきました。
            現在は企業のWeb・マーケティング支援と並行して、茨城県特化の地域メディア「イバトコ」を運営しています。
          </p>
          <p>
            これまで培ってきた知識や経験と、AI・データ・テクノロジーを掛け合わせ、Webやマーケティング、業務改善の仕組み化を支援。
            地域や中小企業が、個人の経験や労働量だけに頼らず、継続的に成果を生み出せる仕組みづくりを目指しています。
          </p>
        </div>
      </div>
    </section>

    <section class="block">
      <h2 class="block__title">シクミベースが大切にしていること</h2>
      <div class="principles">
        <div class="principle">
          <h3>導入することを目的にしない</h3>
          <p>
            WebサイトやSNS、AIの導入自体はゴールではありません。売上、時間、品質のどこを変えたいのかを先に決め、
            そのために必要な手段だけを選びます。
          </p>
        </div>
        <div class="principle">
          <h3>続けられる形にして渡す</h3>
          <p>
            外部に任せ続けないと止まる状態は、仕組みとは呼べません。手順とデータを残し、
            社内で回せるところまで持っていくことを前提に設計します。
          </p>
        </div>
        <div class="principle">
          <h3>自分たちでも実践する</h3>
          <p>
            提案する施策は、まず自社のプロジェクトで試します。地域メディア「イバトコ」は、
            制作・SEO・SNS・AI活用・運用改善を実際に回している場です。
          </p>
        </div>
      </div>
    </section>

    <section class="block">
      <h2 class="block__title">扱っている領域</h2>
      <ul class="services">
        {services.map((service) => (
          <li>
            <a href={`/service/${service.id}/`}>
              <span class="services__name">{service.name}</span>
              <span class="services__summary">{service.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">運営体制について</h2>
      <dl class="facts">
        <div><dt>名称</dt><dd>シクミベース</dd></div>
        <div><dt>運営者</dt><dd>{site.operator}</dd></div>
        <div><dt>所在</dt><dd>東京・茨城</dd></div>
        <div><dt>事業内容</dt><dd>Web制作・改善、SNS運用支援、AI活用・業務改善支援、地域メディア運営</dd></div>
        <div><dt>運営メディア</dt><dd>
          <a href="https://ibatoco.jp/" target="_blank" rel="noopener noreferrer">
            イバトコ（ibatoco.jp）<span aria-hidden="true"> ↗</span>
          </a>
        </dd></div>
      </dl>

      <div class="notice">
        <h3>法人化前の表記について</h3>
        <p>
          シクミベースは、2026年8月現在、法人ではなく{site.operator}が個人で運営する事業ブランドです。
          「株式会社」「代表取締役」といった法人格を示す表記は使用していません。
          法人設立後に、運営主体・会社情報・契約主体などの表記を更新します。
        </p>
      </div>
    </section>

    <section class="cta">
      <h2 class="cta__title">ご相談をお待ちしています</h2>
      <p class="cta__lead">
        依頼内容が固まっていない段階でも構いません。いまの状況を伺い、
        何から手を付けるとよいかを一緒に整理します。
      </p>
      <a class="btn btn--primary" href={ctaHref()} data-cta="about">
        相談する<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</PageLayout>

<style>
  .body {
    max-width: calc(880px + var(--gutter) * 2);
    padding-top: clamp(36px, 4.5vw, 56px);
  }

  .profile {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .profile__visual {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
  }

  .profile__visual img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .profile__name {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    color: var(--navy);
    letter-spacing: 0.04em;
  }

  .profile__role {
    margin-top: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-mute);
  }

  .profile__text {
    display: grid;
    gap: 1.1em;
    margin-top: 20px;
  }

  .block {
    margin-top: clamp(48px, 6vw, 72px);
  }

  .block__title {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    color: var(--navy);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--navy);
    margin-bottom: 24px;
  }

  .principles {
    display: grid;
    gap: 20px;
  }

  .principle h3 {
    font-size: 1.0625rem;
    color: var(--navy);
    padding-left: 14px;
    border-left: 4px solid var(--blue);
  }

  .principle p {
    margin-top: 10px;
    padding-left: 18px;
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .services {
    display: grid;
    gap: 12px;
  }

  .services a {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    transition: border-color 0.25s var(--ease);
  }

  .services a:hover {
    border-color: var(--blue);
  }

  .services__name {
    font-weight: 700;
    color: var(--navy);
  }

  .services__summary {
    font-size: var(--fs-body-sm);
    color: var(--text-mute);
  }

  .facts {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .facts > div {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    background: var(--paper);
  }

  .facts dt {
    padding: 14px 18px;
    background: var(--sky-soft);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--navy);
  }

  .facts dd {
    padding: 14px 18px;
    font-size: var(--fs-body-sm);
  }

  .facts a {
    color: var(--blue-ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .notice {
    margin-top: 24px;
    padding: 20px 24px;
    border-left: 3px solid var(--gold);
    background: var(--paper);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .notice h3 {
    font-size: 0.8125rem;
    color: var(--navy);
  }

  .notice p {
    margin-top: 8px;
    font-size: var(--fs-body-sm);
    line-height: 1.9;
    color: var(--text-mute);
  }

  .cta {
    margin-top: clamp(48px, 6vw, 72px);
    padding: clamp(28px, 3.5vw, 44px);
    border-radius: var(--radius);
    background: var(--navy);
    color: #fff;
  }

  .cta__title {
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.5rem);
  }

  .cta__lead {
    margin-top: 12px;
    font-size: var(--fs-body-sm);
    color: var(--text-on-dark-mute);
  }

  .cta .btn {
    margin-top: 22px;
    background: #fff;
    border-color: #fff;
    color: var(--navy);
  }

  @media (max-width: 780px) {
    .profile {
      grid-template-columns: 1fr;
    }

    .profile__visual img {
      aspect-ratio: 3 / 2;
    }

    .facts > div {
      grid-template-columns: 1fr;
    }

    .facts dt {
      padding-bottom: 6px;
    }
  }
</style>
