---
import PageLayout from '../layouts/PageLayout.astro';
import { site, ctaHref } from '../site.config';
import { services } from '../data/taxonomy';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.operator,
    jobTitle: 'Web Director / System Designer',
    url: new URL('/about/', site.url).href,
    worksFor: { '@type': 'Organization', name: site.name, url: site.url },
    knowsAbout: ['事業の仕組み化', 'Web', 'SEO', 'SNS', 'AI活用', '業務改善', '地域メディア運営'],
  },
};
---

<PageLayout
  title="シクミベースについて｜シクミベース"
  description="シクミベースは、中小企業・地域企業の集客・営業・業務・情報発信を、属人的な頑張りではなく再現可能な仕組みに変える事業ブランドです。"
  kicker="ABOUT"
  heading="シクミベースについて"
  lead="WebやAIを売ることが目的ではありません。事業が継続的に回り、改善され、知識や成果が資産として残る状態をつくります。"
  crumbs={[{ label: 'ホーム', href: '/' }, { label: 'シクミベースについて' }]}
>
  <div class="wrap body">
    <section class="profile">
      <figure class="profile__visual">
        <img src="/operator-illustration-fresh.jpg" alt="シクミベース運営者のイラスト" width="1024" height="1536" loading="eager" decoding="async" />
      </figure>

      <div class="profile__body">
        <h2 class="profile__name">{site.operator}</h2>
        <p class="profile__role">Web Director / シクミベース</p>

        <div class="profile__text">
          <p>
            Web制作・ディレクションを中心に、要件整理、SEO、SNS運用、進行管理、チームの業務改善まで経験してきました。
            現在は企業のWeb・マーケティング支援と並行して、茨城県特化の地域メディア「イバトコ」を運営しています。
          </p>
          <p>
            シクミベースで目指しているのは、受託業務を増やし続けることではなく、成果が出た方法を標準化し、
            AI・データ・運用設計を使って、地域や中小企業が継続的に使える事業基盤へ変えることです。
          </p>
        </div>
      </div>
    </section>

    <section class="block">
      <h2 class="block__title">シクミベースの考え方</h2>
      <div class="principles">
        <div class="principle">
          <h3>手段より、事業課題から始める</h3>
          <p>Web、SNS、AIの導入自体をゴールにしません。売上、時間、品質、属人化のどこを改善するかを先に決めます。</p>
        </div>
        <div class="principle">
          <h3>小さく試し、成果が出たものだけ広げる</h3>
          <p>最初から大規模な仕組みを作らず、ボトルネックが大きい場所から最小単位で検証します。</p>
        </div>
        <div class="principle">
          <h3>人に残すのではなく、会社に残す</h3>
          <p>成果が特定の担当者の経験だけに残らないよう、手順・データ・判断基準・変更履歴として蓄積します。</p>
        </div>
        <div class="principle">
          <h3>自分たちでも実践する</h3>
          <p>地域メディア「イバトコ」を実践フィールドとして、コンテンツ、SEO、SNS、AI、自動化、計測改善を実際に回しています。</p>
        </div>
      </div>
    </section>

    <section class="block">
      <h2 class="block__title">仕組みにする領域</h2>
      <ul class="services">
        {services.map((service) => (
          <li>
            <a href={`/service/${service.id}/`}>
              <span class="services__name">{service.name}</span>
              <span class="services__summary">{service.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">運営体制</h2>
      <dl class="facts">
        <div><dt>名称</dt><dd>シクミベース</dd></div>
        <div><dt>運営者</dt><dd>{site.operator}</dd></div>
        <div><dt>活動拠点</dt><dd>東京・茨城</dd></div>
        <div><dt>事業内容</dt><dd>中小企業・地域企業の集客・営業・発信・業務の仕組み化支援、Web・AI活用、地域メディア運営</dd></div>
        <div><dt>運営メディア</dt><dd><a href="https://ibatoco.jp/" target="_blank" rel="noopener noreferrer">イバトコ（ibatoco.jp） ↗</a></dd></div>
      </dl>

      <div class="notice">
        <h3>法人化前の表記について</h3>
        <p>
          シクミベースは現在、法人ではなく{site.operator}が個人で運営する事業ブランドです。
          法人格があるように誤認される表記は使用せず、法人設立後に運営主体・会社情報・契約主体などを更新します。
        </p>
      </div>
    </section>

    <section class="cta">
      <h2 class="cta__title">どこを仕組み化すべきか、一緒に整理します。</h2>
      <p class="cta__lead">集客・営業・発信・業務のどこに一番大きなボトルネックがあるかを確認し、改善優先順位を整理します。</p>
      <a class="btn btn--primary" href={ctaHref('system')} data-cta="about-system-consult">仕組み化について相談する<span class="btn__arrow" aria-hidden="true">→</span></a>
    </section>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</PageLayout>

<style>
  .body { max-width: calc(880px + var(--gutter) * 2); padding-top: clamp(36px, 4.5vw, 56px); }
  .profile { display: grid; grid-template-columns: minmax(220px,.7fr) minmax(0,1.3fr); gap: clamp(28px,4vw,56px); align-items: start; }
  .profile__visual { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--paper); }
  .profile__visual img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: 50% 30%; }
  .profile__name { font-size: clamp(1.5rem,1.25rem + 1vw,2rem); color: var(--navy); letter-spacing: .04em; }
  .profile__role { margin-top: 6px; font-size: .75rem; font-weight: 700; letter-spacing: .1em; color: var(--text-mute); }
  .profile__text { display: grid; gap: 1.1em; margin-top: 20px; }
  .block { margin-top: clamp(48px,6vw,72px); }
  .block__title { font-size: clamp(1.125rem,1rem + .6vw,1.375rem); color: var(--navy); padding-bottom: 12px; border-bottom: 2px solid var(--navy); margin-bottom: 24px; }
  .principles { display: grid; gap: 20px; }
  .principle h3 { font-size: 1.0625rem; color: var(--navy); padding-left: 14px; border-left: 4px solid var(--blue); }
  .principle p { margin-top: 10px; padding-left: 18px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .services { display: grid; gap: 12px; }
  .services a { display: grid; gap: 6px; padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); transition: border-color .25s var(--ease); }
  .services a:hover { border-color: var(--blue); }
  .services__name { font-weight: 700; color: var(--navy); }
  .services__summary { font-size: var(--fs-body-sm); color: var(--text-mute); }
  .facts { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .facts > div { display: grid; grid-template-columns: 140px minmax(0,1fr); background: var(--paper); }
  .facts dt { padding: 14px 18px; background: var(--sky-soft); font-size: .8125rem; font-weight: 700; color: var(--navy); }
  .facts dd { padding: 14px 18px; font-size: var(--fs-body-sm); }
  .facts a { color: var(--blue-ink); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .notice { margin-top: 24px; padding: 20px 24px; border-left: 3px solid var(--gold); background: var(--paper); border-radius: 0 var(--radius) var(--radius) 0; }
  .notice h3 { font-size: .8125rem; color: var(--navy); }
  .notice p { margin-top: 8px; font-size: var(--fs-body-sm); line-height: 1.9; color: var(--text-mute); }
  .cta { margin-top: clamp(48px,6vw,72px); padding: clamp(28px,3.5vw,44px); border-radius: var(--radius); background: var(--navy); color: #fff; }
  .cta__title { font-size: clamp(1.25rem,1.1rem + .8vw,1.5rem); }
  .cta__lead { margin-top: 12px; font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .cta .btn { margin-top: 22px; background: #fff; border-color: #fff; color: var(--navy); }
  @media (max-width: 780px) { .profile { grid-template-columns: 1fr; } .profile__visual img { aspect-ratio: 3/2; } .facts > div { grid-template-columns: 1fr; } .facts dt { padding-bottom: 6px; } }
</style>
