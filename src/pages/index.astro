---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Project from '../components/Project.astro';
import Operator from '../components/Operator.astro';
import Contact from '../components/Contact.astro';
import ArticleCard from '../components/ArticleCard.astro';

import { publishedSorted } from '../utils/related';
import { site } from '../site.config';

const latest = publishedSorted(await getCollection('knowledge')).slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: site.name,
      url: site.url,
      description: site.description,
      logo: new URL('/og.png', site.url).href,
      founder: { '@type': 'Person', name: site.operator },
      areaServed: { '@type': 'Country', name: '日本' },
      sameAs: ['https://ibatoco.jp/'],
    },
    {
      '@type': 'Service',
      name: '事業の仕組み化支援',
      serviceType: '中小企業・地域企業の集客・営業・業務・情報発信の仕組み化設計と実装',
      url: site.url,
      provider: { '@type': 'Organization', name: site.name, url: site.url },
      audience: { '@type': 'BusinessAudience', audienceType: '中小企業・地域企業の経営者・事業責任者' },
    },
  ],
};
---

<BaseLayout>
  <SiteHeader />

  <main id="main">
    <Hero />
    <About />
    <Services />
    <Process />

    {latest.length > 0 && (
      <section class="knowledge section" id="knowledge">
        <div class="wrap">
          <div class="knowledge__head reveal">
            <p class="kicker">ナレッジ<span class="kicker__en">KNOWLEDGE</span></p>
            <h2 class="section-title">
              <span class="phrase">仕組みで強くするための、</span><span class="phrase">実務知識。</span>
            </h2>
            <p class="section-lead measure">
              属人化、集客、営業、業務改善、AI活用。成果を一度きりで終わらせず、再現できる形にするための判断材料をまとめています。
            </p>
          </div>

          <div class="knowledge__list reveal">
            {latest.map((article) => (
              <ArticleCard
                href={`/knowledge/${article.data.category}/${article.id}/`}
                title={article.data.title}
                description={article.data.description}
                category={article.data.category}
                publishedAt={article.data.publishedAt}
                updatedAt={article.data.updatedAt}
                firstParty={article.data.firstParty}
              />
            ))}
          </div>

          <p class="knowledge__more">
            <a class="btn btn--ghost" href="/knowledge/">ナレッジをすべて見る</a>
          </p>
        </div>
      </section>
    )}

    <Project />
    <Operator />
    <Contact />
  </main>

  <SiteFooter />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .knowledge { background: var(--paper); }
  .kicker__en { margin-left: 8px; color: var(--text-mute); font-weight: 700; opacity: 0.85; }
  .knowledge__head { max-width: 46em; }
  .knowledge__list { margin-top: clamp(32px, 4vw, 48px); border-top: 1px solid var(--line); }
  .knowledge__more { margin-top: clamp(28px, 3.5vw, 40px); }
</style>
