---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ServiceCta from '../../components/ServiceCta.astro';
import { formatDate } from '../../utils/format';
import { publishedCases } from '../../utils/related';

export async function getStaticPaths() {
  const cases = publishedCases(await getCollection('case'));
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const shown = data.updatedAt ?? data.publishedAt;
---

<PageLayout
  title={`${data.title}｜事例｜シクミベース`}
  description={data.description}
  showHeader={false}
  ogType="article"
  crumbs={[
    { label: 'ホーム', href: '/' },
    { label: '事例', href: '/case/' },
    { label: data.title },
  ]}
>
  <article>
    <header class="wrap head">
      <div class="head__meta">
        <span class="head__client">{data.client}</span>
        {data.isOwnProject && <span class="head__badge">自社運営</span>}
      </div>

      <h1 class="head__title">{data.title}</h1>
      <p class="head__desc measure">{data.description}</p>

      <div class="head__facts">
        <div class="fact">
          <dt>課題</dt>
          <dd>{data.challenge}</dd>
        </div>
        <div class="fact">
          <dt>取り組んだこと</dt>
          <dd>
            <ul>
              {data.approach.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
        {data.url && (
          <div class="fact">
            <dt>サイト</dt>
            <dd>
              <a href={data.url} target="_blank" rel="noopener noreferrer">
                {new URL(data.url).hostname}
                <span aria-hidden="true"> ↗</span>
              </a>
              <span class="fact__note">別サイトへ移動します</span>
            </dd>
          </div>
        )}
      </div>

      <time class="head__date" datetime={shown.toISOString()}>
        {data.updatedAt ? `${formatDate(shown)} 更新` : formatDate(shown)}
      </time>
    </header>

    <div class="wrap body">
      <div class="prose">
        <Content />
      </div>

      <ServiceCta services={data.relatedServices} heading="この事例に関連するサービス" />

      <p class="back"><a href="/case/">← 事例一覧へ戻る</a></p>
    </div>
  </article>
</PageLayout>

<style>
  .head {
    padding-block: clamp(24px, 3.5vw, 40px) clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--line);
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .head__client {
    padding: 5px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--blue-ink);
  }

  .head__badge {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--gold);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .head__title {
    margin-top: 16px;
    font-size: clamp(1.625rem, 1.2rem + 1.9vw, 2.5rem);
    color: var(--navy);
    line-height: 1.4;
  }

  .head__desc {
    margin-top: 16px;
    font-size: var(--fs-lead);
    color: var(--text-mute);
  }

  .head__facts {
    display: grid;
    gap: 1px;
    margin-top: 28px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .fact {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    background: var(--paper);
  }

  .fact dt {
    padding: 16px 18px;
    background: var(--sky-soft);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--navy);
  }

  .fact dd {
    padding: 16px 18px;
    font-size: var(--fs-body-sm);
    color: var(--text);
  }

  .fact ul {
    display: grid;
    gap: 6px;
  }

  .fact li {
    position: relative;
    padding-left: 16px;
  }

  .fact li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 7px;
    height: 2px;
    background: var(--blue);
  }

  .fact a {
    color: var(--blue-ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fact__note {
    display: block;
    margin-top: 4px;
    font-size: 0.6875rem;
    color: var(--text-mute);
  }

  .head__date {
    display: block;
    margin-top: 18px;
    font-size: 0.75rem;
    color: var(--text-mute);
  }

  .body {
    max-width: calc(760px + var(--gutter) * 2);
    padding-top: clamp(32px, 4vw, 48px);
  }

  .back {
    margin-top: clamp(40px, 5vw, 56px);
    font-size: var(--fs-body-sm);
    font-weight: 700;
  }

  .back a {
    color: var(--blue-ink);
  }

  @media (max-width: 600px) {
    .fact {
      grid-template-columns: 1fr;
    }

    .fact dt {
      padding-bottom: 8px;
    }
  }
</style>
