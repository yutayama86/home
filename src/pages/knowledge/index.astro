---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories } from '../../data/taxonomy';
import { publishedSorted } from '../../utils/related';

const articles = publishedSorted(await getCollection('knowledge'));
const countByCategory = (id: string) => articles.filter((a) => a.data.category === id).length;
---

<PageLayout
  title="ナレッジ｜シクミベース"
  description="属人化、集客、営業、発信、AI活用、業務改善。中小企業・地域企業が、成果を個人の頑張りではなく仕組みとして残すための実務知識をまとめています。"
  kicker="KNOWLEDGE"
  heading="仕組みで強くするための、実務知識。"
  lead="単なるWeb・SNS・AIの使い方ではなく、社長依存をどう減らすか、営業をどう資産化するか、成果をどう再現可能にするかという視点でまとめています。"
  crumbs={[{ label: 'ホーム', href: '/' }, { label: 'ナレッジ' }]}
>
  <section class="wrap categories">
    <h2 class="visually-hidden">カテゴリ</h2>
    <ul class="categories__list">
      {categories.map((category) => (
        <li>
          <a class="category-card" href={`/knowledge/${category.id}/`}>
            <span class="category-card__name">{category.name}</span>
            <span class="category-card__count">{countByCategory(category.id)}記事</span>
            <span class="category-card__desc">{category.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap philosophy">
    <p class="philosophy__label">編集方針</p>
    <h2>ツールの紹介ではなく、事業の判断材料を残す。</h2>
    <p>
      新規記事を増やすこと自体を目的にせず、検索・実務・自社プロジェクトのデータから、
      経営者や責任者が「次に何を変えるか」を決められる情報を優先します。
    </p>
  </section>

  <section class="wrap list">
    <h2 class="list__title">すべての記事</h2>
    {articles.length === 0 ? (
      <p class="list__empty">記事を準備しています。</p>
    ) : (
      <div class="list__items">
        {articles.map((article) => (
          <ArticleCard
            href={`/knowledge/${article.data.category}/${article.id}/`}
            title={article.data.title}
            description={article.data.description}
            category={article.data.category}
            publishedAt={article.data.publishedAt}
            updatedAt={article.data.updatedAt}
            firstParty={article.data.firstParty}
          />
        ))}
      </div>
    )}
  </section>
</PageLayout>

<style>
  .categories { padding-top: clamp(36px,4.5vw,56px); }
  .categories__list { display: grid; grid-template-columns: repeat(auto-fit,minmax(240px,1fr)); gap: 14px; }
  .category-card { display: grid; align-content: start; gap: 6px; height: 100%; padding: 20px 22px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); transition: border-color .25s var(--ease), transform .25s var(--ease); }
  .category-card:hover { border-color: var(--blue); transform: translateY(-2px); }
  .category-card__name { font-size: 1.0625rem; font-weight: 700; color: var(--navy); }
  .category-card__count { font-size: .6875rem; font-weight: 700; letter-spacing: .08em; color: var(--blue); }
  .category-card__desc { margin-top: 4px; font-size: .8125rem; line-height: 1.85; color: var(--text-mute); }
  .philosophy { margin-top: clamp(44px,6vw,72px); padding: clamp(24px,3vw,34px); border-left: 4px solid var(--gold); background: var(--sky-soft); }
  .philosophy__label { font-size: .6875rem; font-weight: 700; letter-spacing: .1em; color: var(--blue-ink); }
  .philosophy h2 { margin-top: 8px; font-size: clamp(1.2rem,1.05rem + .8vw,1.6rem); color: var(--navy); }
  .philosophy p:last-child { margin-top: 10px; max-width: 52em; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .list { padding-top: clamp(48px,6vw,72px); }
  .list__title { font-size: clamp(1.125rem,1rem + .6vw,1.375rem); color: var(--navy); padding-bottom: 12px; border-bottom: 2px solid var(--navy); }
  .list__empty { padding: 32px 0; color: var(--text-mute); }
</style>
